*.rar
*.zip

# Site assets are part of the page, and the download the site hands out
!assets/*.png
!assets/*.jpg
!assets/*.ico
!site/assets/*.png
!site/assets/*.jpg
!site/assets/*.mp4
!site/downloads/*.zip
